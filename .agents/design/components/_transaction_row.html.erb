<%# .agents/design/components/_transaction_row.html.erb %>
<tr class="hover:bg-surface-container-high transition-colors group">
<td class="px-5 py-4 text-secondary font-normal"><%= date %></td>
<td class="px-5 py-4">
<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-surface border border-outline-variant text-xs <%= type_text_class %>">
<span class="w-1.5 h-1.5 rounded-full <%= type_bg_class %>"></span> <%= type_label %>
</span>
</td>
<td class="px-5 py-4"><%= category %></td>
<td class="px-5 py-4 text-secondary font-normal"><%= cost_center %></td>
<td class="px-5 py-4 flex items-center gap-2">
<div class="w-4 h-4 rounded <%= account_bg_class %> border <%= account_border_class %> flex items-center justify-center">
<span class="material-symbols-outlined text-[10px] <%= account_icon_color_class %>"><%= account_icon %></span>
</div>
<%= account_name %>
</td>
<td class="px-5 py-4"><%= description %></td>
<td class="px-5 py-4 text-right tabular-nums <%= defined?(amount_class) ? amount_class : '' %>"><%= amount %></td>
<td class="px-5 py-4 text-right">
<button class="text-secondary hover:text-on-surface opacity-0 group-hover:opacity-100 transition-opacity">
<span class="material-symbols-outlined text-[18px]">more_vert</span>
</button>
</td>
</tr>
