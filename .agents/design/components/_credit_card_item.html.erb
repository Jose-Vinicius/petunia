<div class="bg-surface-container rounded-lg border border-outline-variant p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:bg-surface-container-high transition-colors">
    <div class="flex flex-col">
        <span class="text-xs text-primary font-medium uppercase tracking-wider"><%= bank %></span>
        <h3 class="text-lg font-headline font-bold text-on-surface"><%= name %></h3>
    </div>
    <div class="flex flex-col md:items-end">
        <p class="text-xs text-secondary uppercase tracking-widest">Limite Total</p>
        <p class="text-base font-medium text-on-surface"><%= total_limit %></p>
    </div>
    <div class="flex flex-col md:items-end">
        <p class="text-xs text-secondary uppercase tracking-widest">Limite Usado</p>
        <p class="text-base font-medium text-error"><%= used_limit %></p>
    </div>
    <div class="flex gap-2">
        <button class="px-4 py-2 bg-surface border border-outline-variant rounded-md text-sm font-medium hover:border-primary hover:text-primary transition-colors">Pagar</button>
        <button class="p-2 bg-surface border border-outline-variant rounded-md text-secondary hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-sm">receipt_long</span>
        </button>
    </div>
</div>
