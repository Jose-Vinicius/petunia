<div class="bg-surface-container rounded-lg border border-outline-variant p-6 hover:bg-surface-container-high transition-colors group relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-1 bg-surface-container-highest"></div>
  <div class="flex justify-between items-start mb-6">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-md bg-surface border border-outline-variant flex items-center justify-center">
        <span class="font-bold text-lg text-on-surface"><%= initial %></span>
      </div>
      <div>
        <h3 class="text-sm font-medium text-on-surface"><%= name %></h3>
        <p class="text-xs text-on-surface-variant"><%= type %></p>
      </div>
    </div>
    <button class="text-secondary hover:text-primary transition-colors">
      <span class="material-symbols-outlined text-lg">more_horiz</span>
    </button>
  </div>
  <div>
    <p class="text-xs text-on-surface-variant mb-1 uppercase tracking-wider">Saldo Atual</p>
    <p class="text-2xl font-headline font-bold text-on-surface tracking-tight"><%= balance %></p>
  </div>
  <div class="mt-6 pt-4 border-t border-outline-variant flex justify-between items-center text-sm">
  </div>
</div>
