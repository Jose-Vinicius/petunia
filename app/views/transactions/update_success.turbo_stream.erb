<%= turbo_stream.update "modal", "" %>
<%= turbo_stream.replace "transactions_content" do %>
  <%= render "summary_cards" %>
  <%= render "filters" %>
  <%= render "list" %>
<% end %>
<% if flash[:notice].present? || flash[:alert].present? %>
  <%= turbo_stream.update "flash_messages" do %>
    <div class="flash-container">
      <% if flash[:notice].present? %>
        <div class="flash-message flash-notice">
          <span><%= flash[:notice] %></span>
        </div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="flash-message flash-alert">
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
