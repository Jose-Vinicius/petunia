<%= form_with(model: transaction, local: true, data: { controller: "transaction-form" }) do |f| %>
  <% if transaction.errors.any? %>
    <div id="error_explanation" style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--error, #ef4444); border-radius: var(--radius-md, 8px); padding: 1rem; margin-bottom: 1.5rem; color: #fca5a5; font-size: 0.9rem;">
      <ul style="margin: 0; padding-left: 1.25rem;">
        <% transaction.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :transaction_type, t("activerecord.attributes.transaction.transaction_type"), class: "form-label" %>
    <%= f.select :transaction_type, [
          [t("transactions.types.expense"), "expense"],
          [t("transactions.types.income"), "income"]
        ], {}, class: "form-input", data: { transaction_form_target: "typeSelect", action: "change->transaction-form#togglePaymentSources" } %>
  </div>

  <div class="form-group">
    <%= f.label :description, t("activerecord.attributes.transaction.description"), class: "form-label" %>
    <%= f.text_field :description, autofocus: true, class: "form-input", placeholder: "Ex: Compras de supermercado, Salário mensal" %>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :amount, t("activerecord.attributes.transaction.amount"), class: "form-label" %>
      <%= f.number_field :amount, step: "0.01", class: "form-input", placeholder: "0.00" %>
    </div>

    <div class="form-group">
      <%= f.label :date, t("activerecord.attributes.transaction.date"), class: "form-label" %>
      <%= f.date_field :date, class: "form-input" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :category_id, t("activerecord.attributes.transaction.category"), class: "form-label" %>
      <%= f.collection_select :category_id, @categories, :id, :name, { prompt: "Selecione uma Categoria" }, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :cost_center_id, t("activerecord.attributes.transaction.cost_center"), class: "form-label" %>
      <%= f.collection_select :cost_center_id, @cost_centers, :id, :name, { include_blank: "Nenhum (Opcional)" }, class: "form-input" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :bank_account_id, t("activerecord.attributes.transaction.bank_account"), class: "form-label" %>
    <%= f.collection_select :bank_account_id, @bank_accounts, :id, :name, { include_blank: "Nenhuma (se usar Cartão de Crédito)" }, class: "form-input" %>
  </div>

  <div class="form-group" data-transaction-form-target="creditCardGroup">
    <%= f.label :credit_card_id, t("activerecord.attributes.transaction.credit_card"), class: "form-label" %>
    <%= f.collection_select :credit_card_id, @credit_cards, :id, :name, { include_blank: "Nenhum (se usar Conta Bancária)" }, class: "form-input", data: { transaction_form_target: "creditCardSelect" } %>
  </div>

  <div class="form-group" style="margin-top: 1.5rem; display: flex; gap: 0.75rem;">
    <%= link_to t("devise.shared.links.back"), transactions_path, data: { turbo_frame: "_top" }, class: "btn btn-secondary" %>
    <%= f.submit t("transactions.new.submit"), class: "btn btn-primary", style: "flex: 1;" %>

  </div>
<% end %>
