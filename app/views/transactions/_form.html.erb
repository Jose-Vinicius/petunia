<%= form_with(model: transaction, local: true, data: { controller: "transaction-form", transaction_form_is_new_value: transaction.new_record? }) do |f| %>
  <% if transaction.errors.any? %>
    <div id="error_explanation" style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--error, #ef4444); border-radius: var(--radius-md, 8px); padding: 1rem; margin-bottom: 1.5rem; color: #fca5a5; font-size: 0.9rem;">
      <ul style="margin: 0; padding-left: 1.25rem;">
        <% transaction.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :transaction_type, t("activerecord.attributes.transaction.transaction_type"), class: "form-label" %>
    <%= f.select :transaction_type, [
          [t("transactions.types.expense"), "expense"],
          [t("transactions.types.income"), "income"],
          [t("transactions.types.transfer"), "transfer"]
        ], {}, class: "form-input", data: { transaction_form_target: "typeSelect", action: "change->transaction-form#togglePaymentSources" } %>
  </div>

  <div class="form-group">
    <%= f.label :description, t("activerecord.attributes.transaction.description"), class: "form-label" %>
    <%= f.text_field :description, autofocus: true, class: "form-input", placeholder: "Ex: Compras de supermercado, Salário mensal" %>
  </div>

  <div class="form-group">
    <%= f.label :status, "Status da Movimentação", class: "form-label" %>
    <%= f.select :status, [
          ["🟢 Efetivada / Realizada (já caiu na conta / paga)", "realized"],
          ["🟡 Pendente / Prevista (agendada / a realizar)", "pending"]
        ], {}, class: "form-input", data: { transaction_form_target: "statusSelect" } %>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :amount, t("activerecord.attributes.transaction.amount"), class: "form-label" %>
      <%= f.text_field :amount,
                       value: (transaction.amount.present? ? number_with_precision(transaction.amount, precision: 2, separator: ",") : nil),
                       class: "form-input",
                       placeholder: "0,00",
                       inputmode: "decimal",
                       data: { installment_form_target: "amountInput", action: "input->installment-form#calculate" } %>
    </div>

    <div class="form-group">
      <%= f.label :date, t("activerecord.attributes.transaction.date"), class: "form-label" %>
      <%= f.text_field :date, value: f.object.date&.strftime('%d/%m/%Y'), class: "form-input", placeholder: "dd/mm/aaaa", data: { controller: "datepicker", transaction_form_target: "dateInput", action: "change->transaction-form#updateCompetenceDate" } %>
    </div>

    <div class="form-group">
      <%= f.label :competence_date, "Data Fatura (Competência)", class: "form-label" %>
      <%= f.text_field :competence_date, value: f.object.competence_date&.strftime('%d/%m/%Y'), class: "form-input", placeholder: "dd/mm/aaaa", data: { controller: "datepicker", transaction_form_target: "competenceDateInput" } %>
    </div>
  </div>

  <% if transaction.new_record? %>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
      <div class="form-group" data-controller="installment-form" style="background: rgba(167, 139, 250, 0.08); border: 1px dashed rgba(167, 139, 250, 0.3); border-radius: var(--radius-md, 8px); padding: 0.85rem 1rem; margin: 0;">
        <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.85rem; color: #a78bfa; font-weight: 600; margin: 0;">
          <input type="checkbox" name="is_installment" value="1" class="form-checkbox" data-installment-form-target="checkbox" data-action="change->installment-form#toggle" />
          <span>Lançamento Parcelado (dividir total)</span>
        </label>

        <div data-installment-form-target="fields" style="display: none; margin-top: 0.85rem; border-top: 1px solid rgba(167, 139, 250, 0.2); padding-top: 0.75rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="flex: 1;">
              <label class="form-label" style="font-size: 0.8rem; margin-bottom: 0.25rem;">Quantidade de Parcelas</label>
              <input type="number" name="total_installments" value="2" min="2" max="72" class="form-input" data-installment-form-target="installmentsInput" data-action="input->installment-form#calculate" style="height: 36px; padding: 0.3rem 0.6rem; font-size: 0.85rem;" />
            </div>
          </div>
          <div data-installment-form-target="previewText" style="margin-top: 0.5rem; font-size: 0.8rem; font-weight: 600; color: #34d399; display: none;"></div>
        </div>
      </div>

      <div class="form-group" data-controller="recurring-form" style="background: rgba(59, 130, 246, 0.08); border: 1px dashed rgba(59, 130, 246, 0.3); border-radius: var(--radius-md, 8px); padding: 0.85rem 1rem; margin: 0;">
        <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.85rem; color: #60a5fa; font-weight: 600; margin: 0;">
          <input type="checkbox" name="is_recurring" value="1" class="form-checkbox" data-recurring-form-target="checkbox" data-action="change->recurring-form#toggle" />
          <span>Lançamento Recorrente (Aluguel, etc.)</span>
        </label>

        <div data-recurring-form-target="fields" style="display: none; margin-top: 0.85rem; border-top: 1px solid rgba(59, 130, 246, 0.2); padding-top: 0.75rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="flex: 1;">
              <label class="form-label" style="font-size: 0.8rem; margin-bottom: 0.25rem;">Projetar Meses (1 a 12)</label>
              <input type="number" name="recurring_months_count" value="12" min="1" max="12" class="form-input" data-recurring-form-target="monthsInput" data-action="input->recurring-form#calculate" style="height: 36px; padding: 0.3rem 0.6rem; font-size: 0.85rem;" />
            </div>
          </div>
          <div data-recurring-form-target="previewText" style="margin-top: 0.5rem; font-size: 0.8rem; font-weight: 600; color: #60a5fa; display: none;"></div>
        </div>
      </div>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :category_id, t("activerecord.attributes.transaction.category"), class: "form-label" %>
      <%= f.collection_select :category_id, @categories, :id, :name, { prompt: "Selecione uma Categoria" }, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :cost_center_id, t("activerecord.attributes.transaction.cost_center"), class: "form-label" %>
      <%= f.collection_select :cost_center_id, @cost_centers, :id, :name, { include_blank: "Nenhum (Opcional)" }, class: "form-input" %>
    </div>
  </div>

  <div class="form-group" data-controller="quick-supplier">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
      <%= f.label :supplier_id, t("activerecord.attributes.transaction.supplier"), class: "form-label", style: "margin: 0;" %>
      <button type="button" class="btn btn-ghost" style="padding: 0.1rem 0.4rem; font-size: 0.8rem; color: var(--primary);" data-action="click->quick-supplier#toggle">
        + <%= t("suppliers.quick_add.button") %>
      </button>
    </div>

    <%= f.collection_select :supplier_id, @suppliers, :id, :name, { prompt: t("transactions.form.select_supplier") }, class: "form-input", data: { quick_supplier_target: "select" } %>

    <div data-quick-supplier-target="formContainer" style="display: none; margin-top: 0.5rem; background: var(--surface-hover, #18181b); padding: 0.75rem; border-radius: var(--radius-md, 8px); border: 1px solid var(--border, #27272a);">
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <input type="text" placeholder="<%= t('suppliers.quick_add.placeholder') %>" class="form-input" data-quick-supplier-target="input" style="flex: 1;" />
        <button type="button" class="btn btn-primary" style="padding: 0.4rem 0.75rem; font-size: 0.85rem;" data-action="click->quick-supplier#submit">
          <%= t("suppliers.quick_add.save") %>
        </button>
        <button type="button" class="btn btn-secondary" style="padding: 0.4rem 0.5rem; font-size: 0.85rem;" data-action="click->quick-supplier#toggle">
          ✕
        </button>
      </div>
      <span data-quick-supplier-target="error" style="color: var(--error, #ef4444); font-size: 0.8rem; display: none; margin-top: 0.35rem;"></span>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :bank_account_id, t("activerecord.attributes.transaction.bank_account"), class: "form-label" %>
    <%= f.collection_select :bank_account_id, @bank_accounts, :id, :name, { include_blank: "Nenhuma (se usar Cartão de Crédito)" }, class: "form-input" %>
  </div>

  <div class="form-group" data-transaction-form-target="creditCardGroup">
    <%= f.label :credit_card_id, t("activerecord.attributes.transaction.credit_card"), class: "form-label" %>
    <% card_options = [["Nenhum (se usar Conta Bancária)", ""]] + @credit_cards.map { |c| [c.name, c.id, { "data-closing-day" => c.closing_day, "data-due-day" => c.due_day }] } %>
    <%= f.select :credit_card_id, options_for_select(card_options, transaction.credit_card_id), {}, class: "form-input", data: { transaction_form_target: "creditCardSelect", action: "change->transaction-form#togglePaymentSources" } %>
  </div>

  <div class="form-group" data-transaction-form-target="refundGroup" style="display: none; background: rgba(52, 211, 153, 0.08); border: 1px dashed rgba(52, 211, 153, 0.3); border-radius: var(--radius-md, 8px); padding: 0.75rem 1rem; margin-bottom: 1rem;">
    <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.85rem; color: #34d399; font-weight: 500; margin: 0;">
      <%= f.check_box :is_refund, class: "form-checkbox", data: { transaction_form_target: "refundCheckbox" } %>
      <span>Este lançamento é um <strong>estorno / reembolso</strong> na fatura do cartão</span>
    </label>
  </div>

  <div class="form-group" data-transaction-form-target="destinationBankAccountGroup" style="display: none;">
    <%= f.label :destination_bank_account_id, "Conta de Destino", class: "form-label" %>
    <%= f.collection_select :destination_bank_account_id, @bank_accounts, :id, :name, { include_blank: "Selecione a Conta de Destino" }, class: "form-input" %>
  </div>

  <div class="form-group" style="margin-top: 1.5rem; display: flex; gap: 0.75rem;">
    <%= link_to t("devise.shared.links.back"), transactions_path, data: { turbo_frame: "_top" }, class: "btn btn-secondary" %>
    <%= f.submit (transaction.new_record? ? t("transactions.new.submit") : "Atualizar Lançamento"), class: "btn btn-primary", style: "flex: 1;" %>
  </div>
<% end %>
