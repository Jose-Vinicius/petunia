<%= turbo_frame_tag "modal" do %>
  <div class="modal-backdrop">
    <div class="modal-container">
      <div class="modal-header">
        <div>
          <h2 class="modal-title"><%= t("imports.new.title") %></h2>
          <p class="modal-subtitle"><%= t("imports.new.subtitle") %></p>
        </div>
        <%= link_to transactions_path, data: { turbo_frame: "_top" }, class: "modal-close", title: "Fechar" do %>
          <span class="material-symbols-outlined">close</span>
        <% end %>
      </div>

      <%= render "form" %>
    </div>
  </div>
<% end %>
