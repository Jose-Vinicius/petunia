<div style="max-width: 1000px; width: 100%; margin: 1.5rem auto; padding: 0 1rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.5rem 0;">
        <%= t("imports.new.title") %>
      </h1>
      <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
        <%= t("imports.new.subtitle") %>
      </p>
    </div>

    <div>
      <%= link_to transactions_path, class: "btn btn-secondary" do %>
        <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">arrow_back</span>
        Voltar para Transações
      <% end %>
    </div>
  </div>

  <% if flash[:alert].present? %>
    <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--error, #ef4444); border-radius: var(--radius-md, 8px); padding: 0.85rem 1rem; margin-bottom: 1.5rem; color: #fca5a5; font-size: 0.9rem;">
      <strong>⚠️ <%= flash[:alert] %></strong>
    </div>
  <% end %>

  <div class="card" style="background: var(--surface-card, #18181b); border: 1px solid var(--border, #27272a); border-radius: var(--radius-lg, 12px); padding: 1.75rem;">
    <div class="mobile-only" style="background: rgba(234, 179, 8, 0.1); border: 1px solid #eab308; border-radius: var(--radius-md, 8px); padding: 0.85rem 1rem; margin-bottom: 1.25rem; color: #fef08a; font-size: 0.85rem;">
      <strong>📱 Observação:</strong> A funcionalidade de leitura e pré-visualização de planilhas foi projetada para telas de computador (desktop).
    </div>

    <div style="background: rgba(167, 139, 250, 0.08); border: 1px solid rgba(167, 139, 250, 0.2); border-radius: var(--radius-md, 8px); padding: 1.25rem; margin-bottom: 2rem; font-size: 0.9rem; color: var(--text-secondary);">
      <strong style="color: var(--primary); display: block; margin-bottom: 0.5rem; font-size: 0.95rem;">💡 Colunas suportadas na planilha:</strong>
      <span>Data, Data Competência, Descrição, Valor, Tipo, Categoria, Fornecedor, Centro de Custo, Conta Bancária, Cartão de Crédito, Parcela Atual, Parcela Total e Estorno.</span>

      <div style="margin-top: 1rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <%= link_to download_template_imports_path(sample: false), data: { turbo: false }, class: "btn btn-secondary", style: "font-size: 0.85rem; padding: 0.4rem 0.75rem;" do %>
          <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">download</span>
          <%= t("imports.new.download_header_only") %> (.xlsx)
        <% end %>

        <%= link_to download_template_imports_path(sample: true), data: { turbo: false }, class: "btn btn-secondary", style: "font-size: 0.85rem; padding: 0.4rem 0.75rem;" do %>
          <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">download</span>
          <%= t("imports.new.download_with_sample") %> (.xlsx)
        <% end %>
      </div>
    </div>

    <%= form_with url: preview_imports_path, method: :post, multipart: true, data: { turbo: false } do |f| %>
      <div class="form-group">
        <label class="form-label" style="font-weight: 600; font-size: 0.95rem; margin-bottom: 0.5rem; display: block;"><%= t("imports.new.file_label") %></label>
        <input type="file" name="file" accept=".csv, .xlsx, .xls" required class="form-input" style="padding: 0.6rem; font-size: 0.9rem;" />
      </div>

      <div class="form-group" style="margin-top: 2rem; display: flex; gap: 0.75rem; justify-content: flex-end;">
        <%= link_to t("devise.shared.links.back"), transactions_path, class: "btn btn-secondary" %>
        <button type="submit" class="btn btn-primary" style="padding: 0.6rem 1.5rem;">
          <span class="material-symbols-outlined" style="font-size: 1.2rem; vertical-align: middle;">preview</span>
          Carregar e Visualizar Planilha
        </button>
      </div>
    <% end %>
  </div>
</div>
