<div data-controller="import-preview">
  <div data-import-preview-target="errorContainer" style="display: none; background: rgba(239, 68, 68, 0.1); border: 1px solid var(--error, #ef4444); border-radius: var(--radius-md, 8px); padding: 0.75rem 1rem; margin-bottom: 1rem; color: #fca5a5; font-size: 0.85rem;"></div>

  <!-- STEP 1: FILE SELECTION -->
  <div data-import-preview-target="formContainer">
    <div class="mobile-only" style="background: rgba(234, 179, 8, 0.1); border: 1px solid #eab308; border-radius: var(--radius-md, 8px); padding: 0.85rem 1rem; margin-bottom: 1rem; color: #fef08a; font-size: 0.85rem;">
      <strong>📱 Observação:</strong> A funcionalidade de leitura e pré-visualização de planilhas foi projetada para telas de computador (desktop).
    </div>
    <div style="background: rgba(167, 139, 250, 0.08); border: 1px solid rgba(167, 139, 250, 0.2); border-radius: var(--radius-md, 8px); padding: 1rem; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--text-secondary);">
      <strong style="color: var(--primary); display: block; margin-bottom: 0.35rem;">💡 Colunas suportadas na planilha:</strong>
      <span>Data, Data Competência, Descrição, Valor, Tipo, Categoria, Fornecedor, Centro de Custo, Conta Bancária, Cartão de Crédito e Estorno.</span>
      
      <div style="margin-top: 0.75rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <%= link_to download_template_imports_path(sample: false), data: { turbo: false }, class: "btn btn-secondary", style: "font-size: 0.8rem; padding: 0.35rem 0.65rem;" do %>
          <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">download</span>
          <%= t("imports.new.download_header_only") %>
        <% end %>
        
        <%= link_to download_template_imports_path(sample: true), data: { turbo: false }, class: "btn btn-secondary", style: "font-size: 0.8rem; padding: 0.35rem 0.65rem;" do %>
          <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">download</span>
          <%= t("imports.new.download_with_sample") %>
        <% end %>
      </div>
    </div>

    <form data-action="submit->import-preview#loadPreview">
      <div class="form-group">
        <label class="form-label"><%= t("imports.new.file_label") %></label>
        <input type="file" accept=".csv, .xlsx, .xls" required class="form-input" data-import-preview-target="fileInput" />
      </div>

      <div class="form-group" style="margin-top: 1.5rem; display: flex; gap: 0.75rem;">
        <%= link_to t("devise.shared.links.back"), transactions_path, data: { turbo_frame: "_top" }, class: "btn btn-secondary" %>
        <button type="submit" class="btn btn-primary" style="flex: 1;">
          <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">preview</span>
          Carregar e Visualizar Planilha
        </button>
      </div>
    </form>
  </div>

  <!-- LOADING INDICATOR -->
  <div data-import-preview-target="loadingContainer" style="display: none; text-align: center; padding: 2rem;">
    <span class="material-symbols-outlined" style="font-size: 2.5rem; color: var(--primary);">sync</span>
    <p style="color: var(--text-secondary); margin-top: 0.5rem;">Lendo planilha e gerando preview...</p>
  </div>

  <!-- STEP 2: EDITABLE PREVIEW TABLE -->
  <div data-import-preview-target="previewContainer" style="display: none;">
    <div style="display: flex; justify-content: space-between; align-items: center; background: var(--surface-hover, #18181b); padding: 0.75rem 1rem; border-radius: var(--radius-md, 8px); border: 1px solid var(--border, #27272a); margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
      <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.82rem;">
        <span style="font-weight: 600; color: var(--text-primary);" data-import-preview-target="rowCount">0 transações</span>
        <span style="display: inline-flex; align-items: center; gap: 0.25rem; color: #34d399; background: rgba(52, 211, 153, 0.1); padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid rgba(52, 211, 153, 0.2);">
          🟢 Existente
        </span>
        <span style="display: inline-flex; align-items: center; gap: 0.25rem; color: #facc15; background: rgba(250, 204, 21, 0.1); padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid rgba(250, 204, 21, 0.2);">
          🟡 Novo Cadastro
        </span>
      </div>

      <div style="display: flex; gap: 0.5rem;">
        <button type="button" class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.4rem 0.75rem;" data-action="click->import-preview#cancelPreview">
          Trocar Arquivo
        </button>
        <button type="button" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.4rem 1rem;" data-action="click->import-preview#confirmImport" data-import-preview-target="confirmBtn">
          Confirmar Importação
        </button>
      </div>
    </div>

    <div style="max-height: 440px; overflow-x: auto; overflow-y: auto; border: 1px solid var(--border, #27272a); border-radius: var(--radius-md, 8px);">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.82rem;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border, #27272a); background: var(--surface-card, #121215); color: var(--text-secondary); text-transform: uppercase; font-size: 0.75rem;">
            <th style="padding: 0.6rem 0.5rem; min-width: 125px;">Data</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 125px;">Competência</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 160px;">Descrição</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 90px;">Valor (R$)</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 95px;">Tipo</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 140px;">Categoria</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 140px;">Fornecedor/Cliente</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 130px;">Centro Custo</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 130px;">Conta Bancária</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 130px;">Cartão Crédito</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 75px; text-align: center;">Parcelas</th>
            <th style="padding: 0.6rem 0.5rem; min-width: 70px; text-align: center;">Estorno</th>
            <th style="padding: 0.6rem 0.5rem; text-align: center; width: 40px;">Ação</th>
          </tr>
        </thead>
        <tbody data-import-preview-target="tableBody">
        </tbody>
      </table>
    </div>
  </div>
</div>
