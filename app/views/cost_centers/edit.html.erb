<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <h2 class="auth-title"><%= t("cost_centers.edit.title") %></h2>
      <p class="auth-subtitle"><%= t("cost_centers.edit.subtitle") %></p>
    </div>

    <%= form_with(model: @cost_center, local: true) do |f| %>
      <% if @cost_center.errors.any? %>
        <div id="error_explanation" style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--error, #ef4444); border-radius: var(--radius-md, 8px); padding: 1rem; margin-bottom: 1.5rem; color: #fca5a5; font-size: 0.9rem;">
          <ul style="margin: 0; padding-left: 1.25rem;">
            <% @cost_center.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :name, t("activerecord.attributes.cost_center.name"), class: "form-label" %>
        <%= f.text_field :name, autofocus: true, class: "form-input" %>
      </div>

      <div class="form-group" style="margin-top: 1.5rem; display: flex; gap: 0.75rem;">
        <%= link_to t("devise.shared.links.back"), cost_centers_path, class: "btn btn-secondary" %>
        <%= f.submit t("cost_centers.edit.submit"), class: "btn btn-primary", style: "flex: 1;" %>
      </div>
    <% end %>
  </div>
</div>
