<div style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.5rem 0;">
        <%= t("cost_centers.index.title") %>
      </h1>
      <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
        <%= t("cost_centers.index.subtitle") %>
      </p>
    </div>

    <%= link_to t("cost_centers.index.new_button"), new_cost_center_path, class: "btn btn-primary" %>
  </div>

  <% if @cost_centers.empty? %>
    <div style="background: var(--surface-card, #121215); border: 1px solid var(--border, #27272a); border-radius: var(--radius-lg, 12px); padding: 3rem 1.5rem; text-align: center; color: var(--text-secondary);">
      <span class="material-symbols-outlined" style="font-size: 3rem; color: var(--border, #27272a); margin-bottom: 1rem;">pie_chart</span>
      <p style="margin: 0 0 1.5rem 0;"><%= t("cost_centers.index.empty") %></p>
      <%= link_to t("cost_centers.index.new_button"), new_cost_center_path, class: "btn btn-primary" %>
    </div>
  <% else %>
    <div class="table-responsive" style="background: var(--surface-card, #121215); border: 1px solid var(--border, #27272a); border-radius: var(--radius-lg, 12px); overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border, #27272a); background: var(--surface-hover, #18181b); color: var(--text-secondary); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em;">
            <th style="padding: 0.85rem 1rem;">Descrição</th>
            <th style="padding: 0.85rem 1rem; width: 140px;">Tipo</th>
            <th style="padding: 0.85rem 1rem; text-align: right; width: 160px;">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @cost_centers.each do |cost_center| %>
            <tr style="border-bottom: 1px solid var(--border, #27272a);">
              <td style="padding: 0.85rem 1rem;">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                  <span class="material-symbols-outlined" style="color: #fbbf24; font-size: 1.3rem;">pie_chart</span>
                  <span style="font-weight: 600; color: var(--text-primary);"><%= cost_center.name %></span>
                </div>
              </td>
              <td style="padding: 0.85rem 1rem;">
                <% if cost_center.default? %>
                  <span style="font-size: 0.75rem; background: rgba(167, 139, 250, 0.15); color: var(--primary, #a78bfa); border: 1px solid rgba(167, 139, 250, 0.3); padding: 0.2rem 0.6rem; border-radius: 999px; font-weight: 500;">
                    <%= t("cost_centers.index.default_badge") %>
                  </span>
                <% else %>
                  <span style="font-size: 0.75rem; background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); padding: 0.2rem 0.6rem; border-radius: 999px; font-weight: 500;">
                    <%= t("cost_centers.index.custom_badge") %>
                  </span>
                <% end %>
              </td>
              <td style="padding: 0.85rem 1rem; text-align: right; white-space: nowrap;">
                <div style="display: flex; gap: 0.35rem; justify-content: flex-end; align-items: center;">
                  <%= link_to edit_cost_center_path(cost_center), class: "btn btn-ghost", style: "padding: 0.3rem 0.5rem; font-size: 0.85rem;" do %>
                    <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">edit</span>
                    <%= t("helpers.submit.update", model: "") %>
                  <% end %>
                  <%= button_to cost_center_path(cost_center), method: :delete, data: { turbo_confirm: t("cost_centers.destroy.confirm") }, class: "btn btn-ghost", style: "color: var(--error, #ef4444); padding: 0.3rem 0.5rem; font-size: 0.85rem;" do %>
                    <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">delete</span>
                    <%= t("account_users.index.remove") %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
