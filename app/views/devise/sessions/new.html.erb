<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <h2 class="auth-title"><%= t("devise.sessions.new.title") %></h2>
      <p class="auth-subtitle"><%= t("devise.sessions.new.subtitle") %></p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, t("devise.sessions.new.email_label"), class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", placeholder: t("devise.sessions.new.email_placeholder") %>
      </div>

      <div class="form-group">
        <%= f.label :password, t("devise.sessions.new.password_label"), class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-input", placeholder: t("devise.sessions.new.password_placeholder") %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem;">
          <%= f.check_box :remember_me, style: "accent-color: var(--primary);" %>
          <%= f.label :remember_me, t("devise.sessions.new.remember_me"), class: "form-label", style: "margin-bottom: 0;" %>
        </div>
      <% end %>

      <div class="form-group" style="margin-top: 1.5rem;">
        <%= f.submit t("devise.sessions.new.submit"), class: "btn btn-primary btn-block" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
