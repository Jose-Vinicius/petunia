<div style="max-width: 96%; width: 100%; margin: 1.5rem auto; padding: 0 1rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.5rem 0;">
        <%= t("accounts.index.title") %>
      </h1>
      <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
        <%= t("accounts.index.subtitle") %>
      </p>
    </div>

    <%= link_to t("accounts.index.new_account"), new_account_path, class: "btn btn-primary" %>
  </div>

  <div class="table-responsive" style="background: var(--surface-card, #121215); border: 1px solid var(--border, #27272a); border-radius: var(--radius-lg, 12px); overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border, #27272a); background: var(--surface-hover, #18181b); color: var(--text-secondary); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em;">
          <th style="padding: 0.85rem 1rem;">Descrição</th>
          <th style="padding: 0.85rem 1rem; width: 140px;">Status</th>
          <th style="padding: 0.85rem 1rem; text-align: right; width: 280px;">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @accounts.each do |account| %>
          <% is_active = (current_account == account) %>
          <tr style="border-bottom: 1px solid var(--border, #27272a);">
            <td style="padding: 0.85rem 1rem;">
              <div style="display: flex; align-items: center; gap: 0.6rem;">
                <span class="material-symbols-outlined" style="color: <%= is_active ? 'var(--primary, #a78bfa)' : 'var(--text-secondary)' %>; font-size: 1.3rem;">domain</span>
                <span style="font-weight: 600; color: var(--text-primary);"><%= account.name %></span>
              </div>
            </td>
            <td style="padding: 0.85rem 1rem;">
              <% if is_active %>
                <span style="font-size: 0.75rem; background: rgba(167, 139, 250, 0.15); color: var(--primary, #a78bfa); border: 1px solid rgba(167, 139, 250, 0.3); padding: 0.2rem 0.6rem; border-radius: 999px; font-weight: 600;">
                  🟢 <%= t("accounts.index.active") %>
                </span>
              <% else %>
                <span style="font-size: 0.75rem; background: rgba(113, 113, 122, 0.15); color: var(--text-secondary); border: 1px solid rgba(113, 113, 122, 0.3); padding: 0.2rem 0.6rem; border-radius: 999px; font-weight: 500;">
                  Inativo
                </span>
              <% end %>
            </td>
            <td style="padding: 0.85rem 1rem; text-align: right; white-space: nowrap;">
              <div style="display: flex; gap: 0.35rem; justify-content: flex-end; align-items: center;">
                <% unless is_active %>
                  <%= button_to switch_account_path(account), method: :post, class: "btn btn-secondary", style: "padding: 0.3rem 0.6rem; font-size: 0.85rem;" do %>
                    <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">swap_horiz</span>
                    <%= t("accounts.index.switch") %>
                  <% end %>
                <% end %>

                <% account_user = current_user.account_users.find_by(account: account) %>
                <% if account_user&.role == "owner" %>
                  <%= link_to account_account_users_path(account), class: "btn btn-ghost", style: "padding: 0.3rem 0.6rem; font-size: 0.85rem;" do %>
                    <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">group</span>
                    <%= t("accounts.index.manage_members") %>
                  <% end %>

                  <details style="display: inline-block; text-align: left; position: relative;">
                    <summary class="btn btn-ghost" style="padding: 0.3rem 0.5rem; font-size: 0.8rem; color: var(--text-secondary); cursor: pointer; display: inline-flex; align-items: center; gap: 0.2rem;" title="Opções avançadas de manutenção">
                      <span class="material-symbols-outlined" style="font-size: 1rem; color: var(--text-secondary);">warning</span>
                      <span style="font-size: 0.75rem;">Zona de Perigo</span>
                    </summary>
                    <div style="position: absolute; right: 0; margin-top: 0.4rem; background: #18181b; border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 8px; padding: 0.85rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.7); z-index: 50; width: 280px; white-space: normal;">
                      <div style="font-weight: 600; color: #ef4444; font-size: 0.82rem; margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.3rem;">
                        <span class="material-symbols-outlined" style="font-size: 1rem;">backspace</span>
                        <span><%= t("accounts.reset.title") %></span>
                      </div>
                      <p style="font-size: 0.75rem; color: var(--text-secondary); margin: 0 0 0.75rem 0; line-height: 1.35;">
                        <%= t("accounts.reset.warning") %>
                      </p>
                      <%= button_to reset_data_account_path(account), method: :post, data: { turbo_confirm: t("accounts.reset.confirm", name: account.name) }, class: "btn btn-ghost", style: "width: 100%; color: #ef4444; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); font-size: 0.78rem; padding: 0.4rem; justify-content: center; display: flex; align-items: center; gap: 0.3rem;" do %>
                        <span class="material-symbols-outlined" style="font-size: 0.95rem;">restart_alt</span>
                        <span><%= t("accounts.reset.button") %></span>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
