<%= form_with(model: recurring_transaction, url: (recurring_transaction.persisted? ? recurrence_path(recurring_transaction) : recurrences_path), local: true) do |f| %>
  <% if recurring_transaction.errors.any? %>
    <div id="error_explanation" style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--error, #ef4444); border-radius: var(--radius-md, 8px); padding: 1rem; margin-bottom: 1.5rem; color: #fca5a5; font-size: 0.9rem;">
      <ul style="margin: 0; padding-left: 1.25rem;">
        <% recurring_transaction.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :transaction_type, "Tipo de Movimentação", class: "form-label" %>
    <%= f.select :transaction_type, [
          ["Despesa (Gasto recorrente)", "expense"],
          ["Receita (Entrada / Salário recorrente)", "income"]
        ], {}, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :description, "Descrição / Identificação", class: "form-label" %>
    <%= f.text_field :description, autofocus: true, class: "form-input", placeholder: "Ex: Aluguel da Casa, Condomínio, Copel, Salário Mensal" %>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :amount, "Valor por Período (R$)", class: "form-label" %>
      <%= f.text_field :amount,
                       value: (recurring_transaction.amount.present? ? number_with_precision(recurring_transaction.amount, precision: 2, separator: ",") : nil),
                       class: "form-input",
                       placeholder: "0,00",
                       inputmode: "decimal" %>
    </div>

    <div class="form-group">
      <%= f.label :frequency, "Frequência de Repetição", class: "form-label" %>
      <%= f.select :frequency, [
            ["🗓️ Mensal (Todo mês)", "monthly"],
            ["🗓️ Semanal (Toda semana)", "weekly"],
            ["📅 Anual (Uma vez por ano)", "yearly"]
          ], {}, class: "form-input" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :start_date, "Data de Início", class: "form-label" %>
      <%= f.text_field :start_date, value: f.object.start_date&.strftime('%d/%m/%Y'), class: "form-input", placeholder: "dd/mm/aaaa", data: { controller: "datepicker" } %>
    </div>

    <% if recurring_transaction.new_record? %>
      <div class="form-group">
        <label class="form-label">Projetar Meses (1 a 12)</label>
        <input type="number" name="recurring_months_count" value="12" min="1" max="12" class="form-input" placeholder="12" />
      </div>
    <% else %>
      <div class="form-group">
        <%= f.label :active, "Status da Regra", class: "form-label" %>
        <%= f.select :active, [
              ["🟢 Ativa (gerando lançamentos)", true],
              ["⏸️ Pausada (suspensa)", false]
            ], {}, class: "form-input" %>
      </div>
    <% end %>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :category_id, "Categoria", class: "form-label" %>
      <%= f.collection_select :category_id, @categories, :id, :name, { prompt: "Selecione uma Categoria" }, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :cost_center_id, "Centro de Custo", class: "form-label" %>
      <%= f.collection_select :cost_center_id, @cost_centers, :id, :name, { include_blank: "Nenhum (Opcional)" }, class: "form-input" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :supplier_id, "Fornecedor / Beneficiário", class: "form-label" %>
    <%= f.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: "Nenhum (Opcional)" }, class: "form-input" %>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
    <div class="form-group">
      <%= f.label :bank_account_id, "Conta Bancária", class: "form-label" %>
      <%= f.collection_select :bank_account_id, @bank_accounts, :id, :name, { include_blank: "Nenhuma (se usar Cartão de Crédito)" }, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :credit_card_id, "Cartão de Crédito", class: "form-label" %>
      <%= f.collection_select :credit_card_id, @credit_cards, :id, :name, { include_blank: "Nenhum (se usar Conta Bancária)" }, class: "form-input" %>
    </div>
  </div>

  <div class="form-group" style="margin-top: 1.5rem; display: flex; gap: 0.75rem;">
    <%= link_to "Voltar", recurrences_path, class: "btn btn-secondary" %>
    <%= f.submit (recurring_transaction.new_record? ? "Salvar Recorrência" : "Atualizar Recorrência"), class: "btn btn-primary", style: "flex: 1;" %>
  </div>
<% end %>
