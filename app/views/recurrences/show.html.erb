<div style="max-width: 1100px; width: 100%; margin: 1.5rem auto; padding: 0 1rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.5rem 0;">
        🔄 <%= @recurring_transaction.description %>
      </h1>
      <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
        Detalhes da regra de recorrência e movimentações vinculadas
      </p>
    </div>

    <div style="display: flex; gap: 0.5rem;">
      <%= link_to edit_recurrence_path(@recurring_transaction), data: { turbo_frame: "modal" }, class: "btn btn-secondary" do %>
        ✏️ Editar Regra
      <% end %>
      <%= link_to recurrences_path, class: "btn btn-secondary" do %>
        <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">arrow_back</span>
        Voltar para Recorrências
      <% end %>
    </div>
  </div>

  <div class="card" style="background: var(--surface-card, #18181b); border: 1px solid var(--border, #27272a); border-radius: var(--radius-lg, 12px); padding: 1.5rem; margin-bottom: 2rem;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem;">
      <div>
        <label style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 0.25rem;">Valor por Período</label>
        <span style="font-size: 1.25rem; font-weight: 700; color: <%= @recurring_transaction.income? ? '#34d399' : '#f87171' %>;">
          <%= @recurring_transaction.income? ? '+ ' : '- ' %> R$ <%= number_with_precision(@recurring_transaction.amount, precision: 2, separator: ',') %>
        </span>
      </div>

      <div>
        <label style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 0.25rem;">Frequência</label>
        <span style="font-size: 1rem; color: var(--text-primary); font-weight: 600;">
          <%= @recurring_transaction.frequency == 'yearly' ? '📅 Anual' : (@recurring_transaction.frequency == 'weekly' ? '🗓️ Semanal' : '🗓️ Mensal') %>
        </span>
      </div>

      <div>
        <label style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 0.25rem;">Status da Regra</label>
        <% if @recurring_transaction.active? %>
          <span style="display: inline-block; padding: 0.25rem 0.6rem; background: rgba(52, 211, 153, 0.15); color: #34d399; border-radius: 9999px; font-size: 0.8rem; font-weight: 600;">
            🟢 Ativa
          </span>
        <% else %>
          <span style="display: inline-block; padding: 0.25rem 0.6rem; background: rgba(156, 163, 175, 0.15); color: #9ca3af; border-radius: 9999px; font-size: 0.8rem; font-weight: 600;">
            ⏸️ Pausada
          </span>
        <% end %>
      </div>

      <div>
        <label style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 0.25rem;">Categoria</label>
        <span style="font-size: 1rem; color: var(--text-primary);">
          🏷️ <%= @recurring_transaction.category&.name || '-' %>
        </span>
      </div>

      <div>
        <label style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 0.25rem;">Fornecedor/Cliente</label>
        <span style="font-size: 1rem; color: var(--text-primary);">
          🏢 <%= @recurring_transaction.supplier&.name || '-' %>
        </span>
      </div>

      <div>
        <label style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 0.25rem;">Meio de Pagamento</label>
        <span style="font-size: 1rem; color: var(--text-primary);">
          <% if @recurring_transaction.credit_card.present? %>
            💳 <%= @recurring_transaction.credit_card.name %>
          <% elsif @recurring_transaction.bank_account.present? %>
            🏦 <%= @recurring_transaction.bank_account.name %>
          <% else %>
            -
          <% end %>
        </span>
      </div>
    </div>
  </div>

  <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1rem;">
    📋 Lançamentos Gerados por esta Recorrência (<%= @transactions.size %>)
  </h2>

  <% if @transactions.empty? %>
    <div style="text-align: center; padding: 2rem; color: var(--text-secondary); background: var(--surface-card, #121215); border-radius: 8px; border: 1px solid var(--border, #27272a);">
      Nenhum lançamento gerado para esta regra.
    </div>
  <% else %>
    <div style="border: 1px solid var(--border, #27272a); border-radius: var(--radius-lg, 12px); overflow-x: auto; background: var(--surface-card, #121215);">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border, #27272a); background: var(--surface-hover, #18181b); color: var(--text-secondary); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em;">
            <th style="padding: 0.85rem 1rem;">Data</th>
            <th style="padding: 0.85rem 1rem;">Competência</th>
            <th style="padding: 0.85rem 1rem;">Descrição</th>
            <th style="padding: 0.85rem 1rem;">Status</th>
            <th style="padding: 0.85rem 1rem; text-align: right;">Valor</th>
          </tr>
        </thead>
        <tbody>
          <% @transactions.each do |tx| %>
            <tr style="border-bottom: 1px solid var(--border, #27272a);">
              <td style="padding: 0.85rem 1rem; color: var(--text-secondary); font-weight: 500;">
                <%= tx.date&.strftime('%d/%m/%Y') %>
              </td>
              <td style="padding: 0.85rem 1rem; color: var(--text-secondary);">
                <%= tx.competence_date&.strftime('%d/%m/%Y') %>
              </td>
              <td style="padding: 0.85rem 1rem; font-weight: 600; color: var(--text-primary);">
                <%= tx.description %>
              </td>
              <td style="padding: 0.85rem 1rem;">
                <% if tx.realized? %>
                  <span style="display: inline-block; padding: 0.2rem 0.55rem; background: rgba(52, 211, 153, 0.15); color: #34d399; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                    🟢 Efetivada
                  </span>
                <% else %>
                  <span style="display: inline-block; padding: 0.2rem 0.55rem; background: rgba(250, 204, 21, 0.15); color: #facc15; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
                    🟡 Pendente
                  </span>
                <% end %>
              </td>
              <td style="padding: 0.85rem 1rem; text-align: right; font-weight: 700; color: <%= tx.income? ? '#34d399' : '#f87171' %>;">
                <%= tx.income? ? '+ ' : '- ' %> R$ <%= number_with_precision(tx.amount, precision: 2, separator: ',') %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
