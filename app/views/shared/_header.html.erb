<header class="navbar">
  <div class="navbar-brand">
    <a href="<%= root_path %>" style="color: inherit; display: flex; align-items: center; gap: 0.5rem;">
      <span class="material-symbols-outlined" style="color: var(--primary);">local_florist</span>
      <span style="font-weight: 700;"><%= t("app.name") %></span>
    </a>

    <% if user_signed_in? && current_account %>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--surface-hover, #18181b); padding: 0.35rem 0.75rem; border-radius: var(--radius-md, 8px); border: 1px solid var(--border, #27272a); font-size: 0.85rem;">
        <span class="material-symbols-outlined" style="font-size: 1.1rem; color: var(--primary);">domain</span>
        <span style="font-weight: 600; color: var(--text-primary);"><%= current_account.name %></span>
        <%= link_to accounts_path, style: "color: var(--text-secondary); text-decoration: none; margin-left: 0.25rem;", title: t("app.accounts") do %>
          <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">swap_horiz</span>
        <% end %>
      </div>
    <% end %>
  </div>
  
  <div class="navbar-nav">
    <% if user_signed_in? %>
      <%= link_to t("app.dashboard"), dashboard_path, class: "btn btn-ghost" %>
      <%= link_to t("app.transactions"), transactions_path, class: "btn btn-ghost" %>

      <%= link_to t("app.bank_accounts"), bank_accounts_path, class: "btn btn-ghost" %>
      <%= link_to t("app.credit_cards"), credit_cards_path, class: "btn btn-ghost" %>
      <%= link_to t("app.categories"), categories_path, class: "btn btn-ghost" %>
      <%= link_to t("app.suppliers"), suppliers_path, class: "btn btn-ghost" %>
      <%= link_to t("app.cost_centers"), cost_centers_path, class: "btn btn-ghost" %>
      <%= link_to t("app.accounts"), accounts_path, class: "btn btn-ghost" %>


      <span style="color: var(--text-secondary); font-size: 0.85rem; margin-left: 0.5rem;">
        <%= current_user.email %>
      </span>
      <%= button_to t("app.logout"), destroy_user_session_path, method: :delete, class: "btn btn-secondary" %>
    <% else %>
      <%= link_to t("app.login"), new_user_session_path, class: "btn btn-ghost" %>
      <%= link_to t("app.register"), new_user_registration_path, class: "btn btn-primary" %>
    <% end %>
  </div>
</header>
