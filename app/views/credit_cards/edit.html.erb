<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <h2 class="auth-title"><%= t("credit_cards.edit.title") %></h2>
      <p class="auth-subtitle"><%= t("credit_cards.edit.subtitle") %></p>
    </div>

    <%= form_with(model: @credit_card, local: true) do |f| %>
      <% if @credit_card.errors.any? %>
        <div id="error_explanation" style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--error, #ef4444); border-radius: var(--radius-md, 8px); padding: 1rem; margin-bottom: 1.5rem; color: #fca5a5; font-size: 0.9rem;">
          <ul style="margin: 0; padding-left: 1.25rem;">
            <% @credit_card.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :name, t("activerecord.attributes.credit_card.name"), class: "form-label" %>
        <%= f.text_field :name, autofocus: true, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :limit, t("activerecord.attributes.credit_card.limit"), class: "form-label" %>
        <%= f.number_field :limit, step: "0.01", min: "0", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :bank_account_id, t("activerecord.attributes.credit_card.bank_account"), class: "form-label" %>
        <%= f.collection_select :bank_account_id, current_account.bank_accounts, :id, :name, {}, { class: "form-input", required: true } %>
      </div>

      <div class="form-group" style="margin-top: 1.5rem; display: flex; gap: 0.75rem;">
        <%= link_to t("devise.shared.links.back"), credit_cards_path, class: "btn btn-secondary" %>
        <%= f.submit t("credit_cards.edit.submit"), class: "btn btn-primary", style: "flex: 1;" %>
      </div>
    <% end %>
  </div>
</div>
