<div style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.5rem 0;">
        <%= t("credit_cards.index.title") %>
      </h1>
      <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
        <%= t("credit_cards.index.subtitle") %>
      </p>
    </div>

    <%= link_to t("credit_cards.index.new_button"), new_credit_card_path, class: "btn btn-primary" %>
  </div>

  <% if current_account.bank_accounts.empty? %>
    <div style="background: rgba(234, 179, 8, 0.1); border: 1px solid #eab308; border-radius: var(--radius-lg, 12px); padding: 1rem 1.25rem; margin-bottom: 1.5rem; color: #fef08a; display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem;">
      <span class="material-symbols-outlined" style="font-size: 1.3rem; color: #eab308;">warning</span>
      <div>
        <strong><%= t("credit_cards.index.no_bank_account_warning") %></strong>
        <div style="margin-top: 0.25rem;">
          <%= link_to t("bank_accounts.index.new_button"), new_bank_account_path, style: "color: #fde047; text-decoration: underline;" %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @credit_cards.empty? %>
    <div style="background: var(--surface-card, #121215); border: 1px solid var(--border, #27272a); border-radius: var(--radius-lg, 12px); padding: 3rem 1.5rem; text-align: center; color: var(--text-secondary);">
      <span class="material-symbols-outlined" style="font-size: 3rem; color: var(--border, #27272a); margin-bottom: 1rem;">credit_card</span>
      <p style="margin: 0 0 1.5rem 0;"><%= t("credit_cards.index.empty") %></p>
      <%= link_to t("credit_cards.index.new_button"), new_credit_card_path, class: "btn btn-primary" %>
    </div>
  <% else %>
    <div class="table-responsive" style="background: var(--surface-card, #121215); border: 1px solid var(--border, #27272a); border-radius: var(--radius-lg, 12px); overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border, #27272a); background: var(--surface-hover, #18181b); color: var(--text-secondary); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em;">
            <th style="padding: 0.85rem 1rem;">Descrição</th>
            <th style="padding: 0.85rem 1rem;">Conta Bancária Vinculada</th>
            <th style="padding: 0.85rem 1rem; text-align: right;">Limite</th>
            <th style="padding: 0.85rem 1rem; text-align: right; width: 160px;">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @credit_cards.each do |credit_card| %>
            <tr style="border-bottom: 1px solid var(--border, #27272a);">
              <td style="padding: 0.85rem 1rem;">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                  <span class="material-symbols-outlined" style="color: #f472b6; font-size: 1.3rem;">credit_card</span>
                  <span style="font-weight: 600; color: var(--text-primary);"><%= credit_card.name %></span>
                </div>
              </td>
              <td style="padding: 0.85rem 1rem; color: var(--text-secondary);">
                <div style="display: flex; align-items: center; gap: 0.4rem;">
                  <span class="material-symbols-outlined" style="font-size: 1.1rem; color: #60a5fa;">account_balance</span>
                  <span><%= credit_card.bank_account.name %></span>
                </div>
              </td>
              <td style="padding: 0.85rem 1rem; text-align: right; font-weight: 600; color: #34d399;">
                <%= number_to_currency(credit_card.limit, unit: "R$ ", separator: ",", delimiter: ".") %>
              </td>
              <td style="padding: 0.85rem 1rem; text-align: right; white-space: nowrap;">
                <div style="display: flex; gap: 0.35rem; justify-content: flex-end; align-items: center;">
                  <%= link_to edit_credit_card_path(credit_card), class: "btn btn-ghost", style: "padding: 0.3rem 0.5rem; font-size: 0.85rem;" do %>
                    <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">edit</span>
                    <%= t("helpers.submit.update", model: "") %>
                  <% end %>
                  <%= button_to credit_card_path(credit_card), method: :delete, data: { turbo_confirm: t("credit_cards.destroy.confirm") }, class: "btn btn-ghost", style: "color: var(--error, #ef4444); padding: 0.3rem 0.5rem; font-size: 0.85rem;" do %>
                    <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">delete</span>
                    <%= t("account_users.index.remove") %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
