<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5">
    <meta name="theme-color" content="#09090b">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="<%= t("app.name") %>">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/themes/dark.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <%= javascript_importmap_tags %>

    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/service-worker.js').catch(() => {});
        });
      }
    </script>
  </head>

  <body>
    <div class="app-container">
      <%= render "shared/header" %>

      <% if notice.present? || alert.present? %>
        <div class="flash-container">
          <% if notice.present? %>
            <div class="flash-message flash-notice">
              <span><%= notice %></span>
            </div>
          <% end %>
          <% if alert.present? %>
            <div class="flash-message flash-alert">
              <span><%= alert %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <main class="app-main">
        <%= yield %>
      </main>

      <%= turbo_frame_tag "modal" %>
    </div>
  </body>
</html>
