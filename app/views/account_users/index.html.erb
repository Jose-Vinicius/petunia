<div style="max-width: 96%; width: 100%; margin: 1.5rem auto; padding: 0 1rem;">
  <div style="margin-bottom: 2rem;">
    <%= link_to accounts_path, style: "color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.25rem; margin-bottom: 1rem;" do %>
      <span class="material-symbols-outlined" style="font-size: 1.1rem;">arrow_back</span>
      <%= t("devise.shared.links.back") %>
    <% end %>

    <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--text-primary); margin: 0 0 0.5rem 0;">
      <%= t("account_users.index.title", name: @account.name) %>
    </h1>
    <p style="color: var(--text-secondary); margin: 0; font-size: 0.95rem;">
      <%= t("account_users.index.subtitle") %>
    </p>
  </div>

  <div style="background: var(--surface-card, #121215); border: 1px solid var(--border, #27272a); border-radius: var(--radius-lg, 12px); padding: 1.5rem; margin-bottom: 2rem;">
    <h2 style="font-size: 1.15rem; font-weight: 600; color: var(--text-primary); margin-top: 0; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
      <span class="material-symbols-outlined" style="color: var(--primary);">person_add</span>
      <%= t("account_users.index.add_title") %>
    </h2>

    <%= form_with(url: account_account_users_path(@account), method: :post, local: true) do |f| %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :email, t("account_users.index.email_label"), class: "form-label" %>
          <%= f.email_field :email, required: true, class: "form-input", placeholder: t("account_users.index.email_placeholder") %>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <%= f.label :password, t("account_users.index.password_label"), class: "form-label" %>
          <%= f.password_field :password, class: "form-input", placeholder: t("account_users.index.password_placeholder") %>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <%= f.label :role, t("account_users.index.role_label"), class: "form-label" %>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--text-primary); font-size: 0.9rem;">
            <%= f.radio_button :role, "member", checked: true, style: "accent-color: var(--primary);" %>
            <%= t("account_users.index.role_member") %>
          </label>
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--text-primary); font-size: 0.9rem;">
            <%= f.radio_button :role, "owner", style: "accent-color: var(--primary);" %>
            <%= t("account_users.index.role_owner") %>
          </label>
        </div>
      </div>

      <div>
        <%= f.submit t("account_users.index.submit"), class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <div style="background: var(--surface-card, #121215); border: 1px solid var(--border, #27272a); border-radius: var(--radius-lg, 12px); padding: 1.5rem;">
    <h2 style="font-size: 1.15rem; font-weight: 600; color: var(--text-primary); margin-top: 0; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
      <span class="material-symbols-outlined" style="color: var(--primary);">group</span>
      <%= t("account_users.index.members_list_title") %> (<%= @account_users.size %>)
    </h2>

    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      <% @account_users.each do |au| %>
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.85rem 1rem; background: var(--surface-hover, #18181b); border-radius: var(--radius-md, 8px); border: 1px solid var(--border, #27272a); flex-wrap: wrap; gap: 0.75rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span class="material-symbols-outlined" style="color: var(--text-secondary);">account_circle</span>
            <div>
              <div style="font-weight: 600; color: var(--text-primary); font-size: 0.95rem;">
                <%= au.user.email %>
                <% if au.user == current_user %>
                  <span style="color: var(--text-secondary); font-weight: 400; font-size: 0.8rem;">(Você)</span>
                <% end %>
              </div>
              <div style="color: var(--text-secondary); font-size: 0.75rem; margin-top: 0.15rem;">
                <%= t("account_users.index.joined_at") %> <%= l(au.created_at.to_date, format: :default) rescue au.created_at.strftime("%d/%m/%Y") %>
              </div>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 1rem;">
            <% if au.role == "owner" %>
              <span style="background: rgba(167, 139, 250, 0.15); color: var(--primary, #a78bfa); font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 999px;">
                <%= t("account_users.index.owner_badge") %>
              </span>
            <% else %>
              <span style="background: rgba(52, 211, 153, 0.15); color: #34d399; font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 999px;">
                <%= t("account_users.index.member_badge") %>
              </span>
            <% end %>

            <% unless au.user == current_user && au.role == "owner" && @account_users.select { |u| u.role == "owner" }.size <= 1 %>
              <%= button_to account_account_user_path(@account, au), method: :delete, data: { turbo_confirm: t("account_users.index.confirm_remove") }, class: "btn btn-ghost", style: "color: var(--error, #ef4444); padding: 0.25rem 0.5rem; font-size: 0.85rem;" do %>
                <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">person_remove</span>
                <%= t("account_users.index.remove") %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
